{
  "info": {
    "name": "ТОиР-Цех — заявки на ремонт (ЛР8)",
    "description": "Импортировать в Postman или Insomnia. Сервер: cd backend && dotnet run → http://localhost:5000. Запускать по порядку (Run collection): запрос 02 сохраняет id созданной заявки в переменную workOrderId. Текущий пользователь до ЛР11 — заголовок X-User-Id: 1 мастер, 2 механик, 5 и 6 слесари. Данные в памяти: после перезапуска сервера список пуст.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "workOrderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 GET список — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/work-orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "work-orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "pm.test('Ответ — массив (пустой список тоже 200 и [])', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 POST создать — 201 (мастер X-User-Id: 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "1"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/work-orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "work-orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Не включается шпиндель\",\n  \"equipmentId\": 3,\n  \"description\": \"После смены инструмента шпиндель не стартует, на пульте ошибка E-12. Станок остановлен.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('Есть id, number, status New, исполнителя нет', () => {",
              "  pm.expect(b.id).to.be.a('number');",
              "  pm.expect(b.number).to.match(/^ЗР-\\d{4}-\\d{4}$/);",
              "  pm.expect(b.status).to.eql('New');",
              "  pm.expect(b.assigneeUserId).to.eql(null);",
              "});",
              "pm.test('Заголовок Location', () => pm.response.to.have.header('Location'));",
              "pm.collectionVariables.set('workOrderId', b.id);"
            ]
          }
        }
      ]
    },
