# Настройки клиента. Скопируйте этот файл в .env (Windows: copy .env.example .env) и перезапустите npm run dev.
# Секретов здесь нет и быть не должно: всё, что начинается с VITE_, попадает в код страницы.

# Адрес ASP.NET Core Web API (схема ЛР2, docs/architecture.md).
VITE_API_BASE_URL=http://localhost:5000

# false — рабочий режим: запросы идут на API (порт 5000). true — учебный mock ЛР6 без входа.
VITE_USE_MOCK=false
